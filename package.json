{
  "name": "levada",
  "version": "1.0.0",
  "description": "LEVADA — PWA do nauki portugalskiego europejskiego (PT-PT) od zera dla Polaków",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "lint:content": "tsx scripts/lint-content.ts",
    "content:status": "tsx scripts/lint-content.ts --update-status",
    "audio:build": "tsx scripts/audio-build.ts",
    "icons:build": "node scripts/build-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:content && npm test && npm run build",
    "ai:proxy": "tsx server/ai-proxy.ts",
    "ai:proxy:mock": "AI_MOCK=1 tsx server/ai-proxy.ts",
    "review:export": "tsx scripts/review-sheet.ts export",
    "review:apply": "tsx scripts/review-sheet.ts apply"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "type": "module",
  "private": true
}
